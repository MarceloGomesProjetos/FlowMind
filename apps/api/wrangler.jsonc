{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "flowmind-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "<HYPERDRIVE_ID>" }
  ]
}